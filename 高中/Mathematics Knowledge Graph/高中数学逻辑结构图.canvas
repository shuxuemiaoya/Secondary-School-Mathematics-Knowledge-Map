		{"id":"767f7807832959b5","type":"text","text":"$\\mathrm{C}_{n + 1}^{m} = \\mathrm{C}_{n}^{m} + \\mathrm{C}_{n}^{m - 1}$","x":-16265,"y":19752,"width":288,"height":60},
