		{"id":"60ffad95768f620e","type":"text","text":"$\\mathrm{A}_n^n = n\\mathrm{A}_{n - 1}^{n - 1}$","x":-16325,"y":19273,"width":250,"height":60},
		{"id":"76b285a57b6798ac","type":"text","text":"$\\mathrm{A}_{n + 1}^{n + 1} - \\mathrm{A}_{n}^{n} = n^{2}\\mathrm{A}_{n - 1}^{n - 1}$","x":-16325,"y":19085,"width":320,"height":60},
		{"id":"45dc0c538b0d5d6c","type":"text","text":"分为三份，一份一本，一份两本，一份三本","x":-19930,"y":19201,"width":250,"height":60},
