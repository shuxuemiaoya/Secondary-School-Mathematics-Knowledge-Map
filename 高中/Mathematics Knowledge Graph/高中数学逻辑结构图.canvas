		{"id":"5fa7bc4e3c9d4c79","type":"text","text":"$\\mathrm{C}_{n}^{k} = \\mathrm{C}_{n}^{k - 1}\\frac{n - k + 1}{k}$","x":-16925,"y":24222,"width":253,"height":60},
