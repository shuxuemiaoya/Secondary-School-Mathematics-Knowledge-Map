		{"id":"b17b797895246fe3","type":"text","text":"$\\frac{\\mathrm{C}_{n}^{k}}{\\mathrm{C}_{n}^{k - 1}} = \\frac{n - k + 1}{k}$","x":-16620,"y":24222,"width":228,"height":60},
