		{"id":"59795b4ab63e81d6","type":"text","text":"$a > b \\implies \\begin{cases} ac > bc, & c > 0 \\\\ ac < bc, & c < 0 \\end{cases}$","x":-4401,"y":-4815,"width":372,"height":102},
		{"id":"9fe68fe6391b3237","type":"text","text":"$a > b\\Leftrightarrow b< a.$","x":-4401,"y":-5115,"width":372,"height":60},
		{"id":"a153b7f1e82950fb","type":"text","text":"$a > b,b > c\\Rightarrow a > c.$","x":-4401,"y":-5017,"width":372,"height":60},
