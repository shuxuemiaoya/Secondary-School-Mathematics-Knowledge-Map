		{"id":"e6601e2d43660cda","type":"text","text":"$\\tan (\\alpha - \\beta) = \\frac {\\tan \\alpha - \\tan \\beta}{1 + \\tan \\alpha \\tan \\beta}. \\quad \\left(\\mathrm{T} _ {(\\alpha - \\beta)}\\right)$","x":2282,"y":1415,"width":337,"height":60},
