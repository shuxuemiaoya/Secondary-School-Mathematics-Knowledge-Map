		{"id":"2ec760609cd7c82f","type":"group","x":-2807,"y":2160,"width":2140,"height":675,"label":"3.1 椭圆"},
		{"id":"42b90d613aa03045","type":"group","x":-1502,"y":-2572,"width":1650,"height":758,"label":"1.3 空间向量及其运算的坐标表示"},
