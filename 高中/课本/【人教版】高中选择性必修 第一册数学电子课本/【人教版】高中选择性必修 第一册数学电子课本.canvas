		{"id":"4de3cfce4e144d7a","type":"group","x":-1199,"y":825,"width":1362,"height":800,"label":"2.5 直线与圆、圆与圆的位置关系"},
		{"id":"4cd496156039d1b7","type":"group","x":-2807,"y":2920,"width":2140,"height":502,"label":"3.2 双曲线"},
		{"id":"3c43375fe3707ae6","type":"group","x":-2528,"y":-395,"width":1469,"height":560,"label":"2.2 直线的方程"},
