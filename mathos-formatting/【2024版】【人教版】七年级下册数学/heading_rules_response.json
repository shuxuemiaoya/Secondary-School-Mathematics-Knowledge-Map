```json
{
  "rules": [
    {
      "id": "chapter_heading",
      "pattern": "^# 第[一二三四五六七八九十]+章 .+$",
      "replacement": "# \\g<0>",
      "flags": ["MULTILINE"]
    },
    {
      "id": "section_heading",
      "pattern": "^(\\d+\\.\\d+\\s+\\S.+)$",
      "replacement": "## \\1",
      "flags": ["MULTILINE"]
    },
    {
      "id": "subsection_heading",
      "pattern": "^(阅读与思考|观察与猜想|探究与发现|数学活动|小结|用经纬度表示地理位置|利用平移设计图案|看图时的错觉|为什么 \\$\\\\sqrt\\{2\\}\\$ 不是有理数)$",
      "replacement": "### \\1",
      "flags": ["MULTILINE"]
    }
  ],
  "notes": [
    "TOC detected with chapter, section, and subsection headings.",
    "Chapter headings (e.g., '# 第七章 相交线与平行线') are preserved as H1.",
    "Section headings (e.g., '7.1 相交线') are promoted to H2.",
    "Subsection headings (e.g., '阅读与思考', '数学活动') are promoted to H3.",
    "Rules preserve math blocks, code fences, image links, and tables."
  ]
}
```